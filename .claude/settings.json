{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Write(./COMPLIANCE.md)",
      "Write(./CLAUDE.md)",
      "Write(./GUARDRAILS.md)",
      "Write(./package.json)",
      "Write(./package-lock.json)",
      "Write(./next.config.js)",
      "Write(./tsconfig.json)",
      "Write(./.env)",
      "Write(./.env.*)",
      "Write(**/.env)",
      "Write(**/.env.*)",
      "Write(./.claude/**)",
      "Write(./.github/**)",
      "Edit(./COMPLIANCE.md)",
      "Edit(./CLAUDE.md)",
      "Edit(./GUARDRAILS.md)",
      "Edit(./package.json)",
      "Edit(./package-lock.json)",
      "Edit(./next.config.js)",
      "Edit(./tsconfig.json)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Edit(./.claude/**)",
      "Edit(./.github/**)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git commit:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr create:*)",
      "Bash(npm publish:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard.js\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard.js\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
